# Copy to backend/.env (export these in your shell; nothing is read from this file automatically).
# --- AI tutor (optional). Without a key the clearly-labelled local rule-based tutor is used.
ANTHROPIC_API_KEY=
CODEVERSE_LLM_MODEL=claude-sonnet-5-5
# --- Execution limits (server-side ceilings)
CV_WALL_TIMEOUT_S=6
CV_CPU_SECONDS=4
CV_MEMORY_MB=768
CV_MAX_EVENTS=1500
CV_MAX_OUTPUT_CHARS=20000
# --- Sandbox layers (best-effort, reported honestly in every /api/execute response)
CV_NETWORK_ISOLATION=1
CV_DROP_PRIVILEGES=1
# --- Storage (not wired up yet; progress tracking is a later stage)
DATABASE_URL=
